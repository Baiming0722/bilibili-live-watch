{
  "name": "bilibili-live-watch",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "npm run build && node server/index.js",
    "start": "node server/index.js",
    "test": "node --test",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "framer-motion": "^12.41.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "build": {
    "appId": "com.bililive.watch",
    "productName": "BiliLive Watch",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BiliLive Watch"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.exe"
    }
  }
}
